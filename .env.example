# =============================================================================
# Настройки GarageAborigineApp (backend API + Telegram-бот)
#
# Файл читают:
#   - backend:  app/core/config.py  (pydantic-settings, регистр имён не важен)
#   - бот:      bot/config.py
#   - docker compose: передаёт файл целиком в контейнеры api и bot
#
# Все параметры необязательные — у каждого есть значение по умолчанию
# (указано ниже). Исключение: BOT_TOKEN, без него бот не запустится.
#
# В Docker часть значений переопределяется в docker-compose.yml
# (отмечено пометкой [docker]) — здесь они нужны для локального запуска.
# Комментарии пишите только отдельной строкой, не после значения.
# =============================================================================


# --- База данных -------------------------------------------------------------

# Строка подключения к PostgreSQL. Драйвер обязательно asyncpg.
# Формат: postgresql+asyncpg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
# Используется API и миграциями (alembic).
# [docker] в контейнере api заменяется на ...@postgres:5432/crm
# По умолчанию: postgresql+asyncpg://crm:crm@localhost:5432/crm
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm

# База для автотестов (pytest). Тесты пересоздают в ней все таблицы,
# поэтому НИКОГДА не указывайте здесь рабочую базу.
# Создать: docker compose exec postgres createdb -U crm crm_test
# По умолчанию: postgresql+asyncpg://crm:crm@localhost:5432/crm_test
TEST_DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm_test

# Печатать все SQL-запросы в лог (true/false). Только для отладки — шумно.
# По умолчанию: false
SQL_ECHO=false


# --- Telegram ----------------------------------------------------------------

# Токен Telegram-бота от @BotFather. ОБЯЗАТЕЛЕН для запуска бота
# (python -m bot.main / сервис bot в compose). Секрет — не коммитить.
# По умолчанию: пусто
BOT_TOKEN=

# Токен, которым API сам отправляет уведомления в Telegram: смена статуса
# визита, запрос согласования доп. работ, готовый документ.
# Обычно тот же, что BOT_TOKEN. Если пусто — уведомления не отправляются,
# а только пишутся в лог (удобно для разработки).
# По умолчанию: пусто
TELEGRAM_BOT_TOKEN=

# Адрес API, к которому обращается бот.
# [docker] в контейнере bot заменяется на http://api:8000
# По умолчанию: http://localhost:8000
API_BASE_URL=http://localhost:8000


# --- Согласие клиента --------------------------------------------------------

# Сколько минут действует QR-ссылка/токен на согласие клиента
# (обработка персональных данных). После истечения нужен новый QR.
# По умолчанию: 15
CONSENT_TOKEN_TTL_MINUTES=15


# --- Поиск -------------------------------------------------------------------

# Порог нечёткого поиска клиентов/авто (pg_trgm similarity, от 0 до 1).
# Меньше — больше результатов, но больше «мусора»; больше — строже.
# По умолчанию: 0.3
SEARCH_FUZZY_THRESHOLD=0.3

# Порог нечёткого поиска по каталогу работ (подсказки при добавлении работы).
# Шкала та же, 0..1.
# По умолчанию: 0.3
CATALOG_FUZZY_THRESHOLD=0.3

# Сколько последних просмотренных карточек показывать пользователю.
# По умолчанию: 10
RECENT_VIEWS_LIMIT=10


# --- Файлы и филиалы ---------------------------------------------------------

# Папка для сгенерированных документов (PDF заказ-нарядов).
# Относительный путь считается от папки, откуда запущен API.
# [docker] в контейнере api заменяется на /data/storage (volume storage)
# По умолчанию: ./storage
FILE_STORAGE_ROOT=./storage

# UUID филиала, который проставляется новым пользователям, клиентам и визитам.
# Задел под несколько филиалов; пока филиал один — не менять, иначе новые
# записи окажутся в другом филиале, чем существующие.
# По умолчанию: 00000000-0000-0000-0000-000000000001
DEFAULT_BRANCH_ID=00000000-0000-0000-0000-000000000001
